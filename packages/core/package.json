{
  "name": "@lens-image/core",
  "version": "0.1.2",
  "description": "Composable image optimization for Node.js. Zero runtime dependencies, pluggable storage adapters and codecs.",
  "license": "MIT",
  "author": "Lens contributors",
  "keywords": [
    "image",
    "optimization",
    "resize",
    "webp",
    "avif",
    "compression",
    "responsive-images",
    "sharp",
    "zero-dependency"
  ],
  "homepage": "https://github.com/Sthabiso10/lens-image#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sthabiso10/lens-image.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Sthabiso10/lens-image/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/esm/browser.d.ts",
        "default": "./dist/esm/browser.js"
      },
      "require": {
        "types": "./dist/cjs/browser.d.ts",
        "default": "./dist/cjs/browser.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "sharp": ">=0.32.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs core"
  }
}
