# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Next.js, for the docs site
.next/
out/
next-env.d.ts

# Generated brand and docs imagery is committed on purpose, so a normal build
# and the CI docs job never need network access. Regenerate it with
# `npm run brand:build` and `npm run hero:build`.

# Local
.DS_Store
.env
.env.*
coverage/
.tmp/
npm-debug.log*
*.tgz

# Editor and agent state
# .claude/launch.json is committed on purpose: it is the shared dev-server
# config, not personal state. Anything local under .claude is not.
.claude/settings.local.json
.claude/*.local.json
.vscode/
.idea/
*.swp

# Tooling caches
.turbo/
.eslintcache
.cache/
.vercel/
